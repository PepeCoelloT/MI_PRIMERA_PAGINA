        <a class="navbar-brand fw-bold" href="#">
            <i class="bi bi-journal-bookmark-fill"></i>
            JC Planner
        </a>

        <button class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menu">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse" id="menu">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">

                    <a class="nav-link active" href="#inicio">

                        <i class="bi bi-house-door-fill"></i>

                        Inicio

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link" href="#registro">

                        <i class="bi bi-pencil-square"></i>

                        Registrar

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link" href="#listado">

                        <i class="bi bi-card-list"></i>

                        Agendas

                    </a>

                </li>

            </ul>

        </div>

    </div>

</nav>

<!--==========================
        HERO
===========================-->

<section id="inicio" class="hero">

<div class="container">

<div class="row align-items-center">

<div class="col-lg-6">

<span class="badge bg-warning text-dark mb-3">

Nueva Colección 2026

</span>

<h1 class="display-4 fw-bold">

Organiza tu tiempo con las mejores agendas.

</h1>

<p class="lead mt-4">

JC Planner te permite registrar, administrar y visualizar todas tus agendas de una forma rápida, moderna y sencilla.

</p>

<div class="mt-4">

<a href="#registro" class="btn btn-primary btn-lg">

<i class="bi bi-plus-circle-fill"></i>

Registrar Agenda

</a>

</div>

</div>

<div class="col-lg-6 text-center">

<img
src="https://images.unsplash.com/photo-1517842645767-c639042777db?auto=format&fit=crop&w=900&q=80"
class="img-fluid hero-img rounded-4 shadow-lg"
alt="Agendas">

</div>

</div>

</div>

</section>

<!--==========================
      CONTADOR
===========================-->

<section class="container my-5">

<div class="row">

<div class="col-md-4">

<div class="card border-0 shadow contador-card">

<div class="card-body text-center">

<i class="bi bi-journal-check display-3 text-primary"></i>

<h3 class="mt-3">

<span id="contador">

0

</span>

</h3>

<p>

Agendas Registradas

</p>

</div>

</div>

</div>

<div class="col-md-8">

<div class="alert alert-primary shadow">

<h5>

<i class="bi bi-lightbulb-fill"></i>

Administra tu inventario utilizando Bootstrap y JavaScript.

</h5>

</div>

</div>

</div>

</section>
<!--==========================
      FORMULARIO
===========================-->

<section id="registro" class="container mb-5">

<div class="card shadow-lg border-0">

<div class="card-header bg-primary text-white py-3">

<h3 class="mb-0">

<i class="bi bi-pencil-square"></i>

Registrar Nueva Agenda

</h3>

</div>

<div class="card-body">

<div id="mensaje"></div>

<form id="agendaForm">

<div class="row">

<div class="col-md-6 mb-3">

<label class="form-label fw-semibold">

Nombre de la Agenda

</label>

<input
type="text"
id="nombre"
class="form-control"
placeholder="Ejemplo: Agenda Profesional">

<div id="errorNombre" class="invalid-feedback"></div>

</div>

<div class="col-md-6 mb-3">

<label class="form-label fw-semibold">

Categoría

</label>

<select
id="categoria"
class="form-select">

<option value="">Seleccione...</option>

<option>Estudiantil</option>

<option>Profesional</option>

<option>Emprendedor</option>

</select>

<div id="errorCategoria" class="invalid-feedback"></div>

</div>

<div class="col-12 mb-3">

<label class="form-label fw-semibold">

Descripción

</label>

<textarea
id="descripcion"
rows="5"
class="form-control"
placeholder="Describe la agenda..."></textarea>

<div id="errorDescripcion" class="invalid-feedback"></div>

</div>

<div class="col-md-6">

<button
type="submit"
class="btn btn-success w-100">

<i class="bi bi-check-circle-fill"></i>

Registrar Agenda

</button>

</div>

<div class="col-md-6">

<button
type="reset"
class="btn btn-outline-secondary w-100">

<i class="bi bi-arrow-clockwise"></i>

Limpiar

</button>

</div>

</div>

</form>

<div class="text-center mt-4">

<div
id="spinner"
class="spinner-border text-primary d-none"
role="status">

<span class="visually-hidden">

Cargando...

</span>

</div>

</div>

</div>

</div>

</section>

<!--==========================
        LISTADO
===========================-->

<section id="listado" class="container mb-5">

<div class="d-flex justify-content-between align-items-center mb-4">

<h2>

<i class="bi bi-card-list"></i>

Agendas Registradas

</h2>

<span class="badge bg-primary p-3">

Inventario JC Planner

</span>

</div>

<div
id="listaAgendas"
class="row g-4">

</div>

</section>

<!--==========================
        MODAL
===========================-->

<div
class="modal fade"
id="modalAgenda"
tabindex="-1">

<div class="modal-dialog modal-dialog-centered">

<div class="modal-content">

<div class="modal-header bg-primary text-white">

<h5 class="modal-title">

<i class="bi bi-info-circle-fill"></i>

Información

</h5>

<button
type="button"
class="btn-close btn-close-white"
data-bs-dismiss="modal">

</button>

</div>

<div
class="modal-body"
id="contenidoModal">

La agenda fue registrada correctamente.

</div>

<div class="modal-footer">

<button
type="button"
class="btn btn-primary"
data-bs-dismiss="modal">

Aceptar

</button>

</div>

</div>

</div>

</div>
<!--==========================
            FOOTER
===========================-->

<footer class="bg-dark text-white py-4">

    <div class="container text-center">

        <h4 class="fw-bold">
            <i class="bi bi-journal-bookmark-fill"></i>
            JC Planner
        </h4>

        <p class="mb-2">
            Organización, creatividad y productividad en un solo lugar.
        </p>

        <div class="mb-3">

            <a href="#" class="text-white fs-4 mx-2">
                <i class="bi bi-facebook"></i>
            </a>

            <a href="#" class="text-white fs-4 mx-2">
                <i class="bi bi-instagram"></i>
            </a>

            <a href="#" class="text-white fs-4 mx-2">
                <i class="bi bi-whatsapp"></i>
            </a>

        </div>


        <p class="mb-0">

            © 2026 JC Planner | Proyecto Desarrollo Web

        </p>


    </div>

</footer>



