/* ============================
   ESTILOS GENERALES
============================ */

body{
    background:#f4f7fb;
    font-family:Arial, Helvetica, sans-serif;
}

/* ============================
   HEADER
============================ */

header{
    background:#0d6efd;
    color:#fff;
}

/* ============================
   TITULOS
============================ */

h2,h3{
    font-weight:bold;
}

/* ============================
   TARJETAS
============================ */

.card{
    border:none;
    border-radius:12px;
}

.card-header{
    border-radius:12px 12px 0 0 !important;
}

/* ============================
   FORMULARIO
============================ */

.form-control,
.form-select{

    transition:.3s;

}

.form-control:focus,
.form-select:focus{

    box-shadow:0 0 10px rgba(13,110,253,.25);

}

/* ============================
   MENSAJES
============================ */

.invalid-feedback{

    display:block;

    font-size:14px;

}

.valid-feedback{

    display:block;

}

/* ============================
   BOTONES
============================ */

.btn{

    transition:.3s;

}

.btn:hover{

    transform:scale(1.03);

}

/* ============================
   TARJETAS REGISTRADAS
============================ */

.agenda-card{

    transition:.3s;

}

.agenda-card:hover{

    transform:translateY(-5px);

}

.agenda-card .card{

    box-shadow:0 5px 15px rgba(0,0,0,.15);

}

/* ============================
   CONTADOR
============================ */

.alert-info{

    font-size:20px;

    text-align:center;

}

/* ============================
   FOOTER
============================ */

footer{

    margin-top:60px;

}

/* ============================
   RESPONSIVE
============================ */

@media(max-width:768px){

header h1{

font-size:28px;

}

h2{

font-size:24px;

}

.card{

margin-bottom:20px;

}

}
